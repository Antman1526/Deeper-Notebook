-- Deeper Notebook vault foundation: rebuildable, read-only canonical projection.

DEFINE TABLE IF NOT EXISTS vault_mount SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE vault_mount TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS name ON TABLE vault_mount TYPE string;
DEFINE FIELD IF NOT EXISTS root_path ON TABLE vault_mount TYPE string;
DEFINE FIELD IF NOT EXISTS format_mode ON TABLE vault_mount TYPE string ASSERT $value IN ["obsidian", "logseq", "mixed", "markdown"];
DEFINE FIELD IF NOT EXISTS status ON TABLE vault_mount TYPE string ASSERT $value IN ["disconnected", "scanning", "ready-read-only", "ready-write-enabled", "stale", "conflict", "degraded", "unavailable"];
DEFINE FIELD IF NOT EXISTS parent_vault_id ON TABLE vault_mount TYPE option<record<vault_mount>>;
DEFINE FIELD IF NOT EXISTS watch_enabled ON TABLE vault_mount TYPE bool DEFAULT false ASSERT $this.format_mode != "mixed" OR $value = false;
DEFINE FIELD IF NOT EXISTS write_policy ON TABLE vault_mount TYPE string DEFAULT "read-only" ASSERT $value IN ["read-only", "guarded-write"];
DEFINE FIELD IF NOT EXISTS protected_globs ON TABLE vault_mount TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS parser_version ON TABLE vault_mount TYPE string;
DEFINE FIELD IF NOT EXISTS last_scan_started_at ON TABLE vault_mount TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS last_scan_completed_at ON TABLE vault_mount TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS created ON TABLE vault_mount TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE vault_mount TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_vault_mount_root ON TABLE vault_mount COLUMNS root_path UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_vault_mount_parent ON TABLE vault_mount COLUMNS parent_vault_id;

DEFINE TABLE IF NOT EXISTS vault_file SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE vault_file TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS vault_id ON TABLE vault_file TYPE record<vault_mount>;
DEFINE FIELD IF NOT EXISTS relative_path ON TABLE vault_file TYPE string;
DEFINE FIELD IF NOT EXISTS file_kind ON TABLE vault_file TYPE string;
DEFINE FIELD IF NOT EXISTS format ON TABLE vault_file TYPE string;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE vault_file TYPE option<string>;
DEFINE FIELD IF NOT EXISTS size_bytes ON TABLE vault_file TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS modified_ns ON TABLE vault_file TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS encoding ON TABLE vault_file TYPE option<string>;
DEFINE FIELD IF NOT EXISTS parse_status ON TABLE vault_file TYPE string DEFAULT "pending" ASSERT $value IN ["pending", "parsed", "unsupported", "invalid", "conflict", "missing"];
DEFINE FIELD IF NOT EXISTS parse_error_code ON TABLE vault_file TYPE option<string>;
DEFINE FIELD IF NOT EXISTS indexed_at ON TABLE vault_file TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS deleted_state ON TABLE vault_file TYPE string DEFAULT "present" ASSERT $value IN ["present", "missing"];
DEFINE FIELD IF NOT EXISTS created ON TABLE vault_file TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE vault_file TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_vault_file_path ON TABLE vault_file COLUMNS vault_id, relative_path UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_vault_file_state ON TABLE vault_file COLUMNS vault_id, deleted_state, parse_status;

DEFINE FIELD IF NOT EXISTS vault_id ON TABLE note TYPE option<record<vault_mount>>;
DEFINE FIELD IF NOT EXISTS vault_file_id ON TABLE note TYPE option<record<vault_file>>;
DEFINE FIELD IF NOT EXISTS source_format ON TABLE note TYPE option<string>;
DEFINE FIELD IF NOT EXISTS canonical_external ON TABLE note TYPE option<bool>;
DEFINE FIELD IF NOT EXISTS properties ON TABLE note FLEXIBLE TYPE option<object>;
DEFINE FIELD IF NOT EXISTS tags ON TABLE note TYPE option<array<string>>;
DEFINE FIELD IF NOT EXISTS source_hash ON TABLE note TYPE option<string>;
DEFINE FIELD IF NOT EXISTS external_state ON TABLE note TYPE option<string>;
DEFINE INDEX IF NOT EXISTS idx_note_vault_file ON TABLE note COLUMNS vault_file_id UNIQUE;

DEFINE TABLE IF NOT EXISTS note_block SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE note_block TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS note_id ON TABLE note_block TYPE record<note>;
DEFINE FIELD IF NOT EXISTS vault_file_id ON TABLE note_block TYPE record<vault_file>;
DEFINE FIELD IF NOT EXISTS parser_id ON TABLE note_block TYPE string;
DEFINE FIELD IF NOT EXISTS parent_block_id ON TABLE note_block TYPE option<record<note_block>>;
DEFINE FIELD IF NOT EXISTS position ON TABLE note_block TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS stable_source_id ON TABLE note_block TYPE option<string>;
DEFINE FIELD IF NOT EXISTS block_kind ON TABLE note_block TYPE string;
DEFINE FIELD IF NOT EXISTS markdown ON TABLE note_block TYPE string;
DEFINE FIELD IF NOT EXISTS plain_text ON TABLE note_block TYPE string;
DEFINE FIELD IF NOT EXISTS properties ON TABLE note_block FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS task_state ON TABLE note_block TYPE option<string>;
DEFINE FIELD IF NOT EXISTS heading_path ON TABLE note_block TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS source_start ON TABLE note_block TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS source_end ON TABLE note_block TYPE int ASSERT $value >= $this.source_start;
DEFINE FIELD IF NOT EXISTS created ON TABLE note_block TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE note_block TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_note_block_parser ON TABLE note_block COLUMNS vault_file_id, parser_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_note_block_note ON TABLE note_block COLUMNS note_id, position;

DEFINE TABLE IF NOT EXISTS note_link SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE note_link TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS source_note_id ON TABLE note_link TYPE record<note>;
DEFINE FIELD IF NOT EXISTS source_block_id ON TABLE note_link TYPE option<record<note_block>>;
DEFINE FIELD IF NOT EXISTS target_note_id ON TABLE note_link TYPE option<record<note>>;
DEFINE FIELD IF NOT EXISTS target_block_id ON TABLE note_link TYPE option<record<note_block>>;
DEFINE FIELD IF NOT EXISTS target_text ON TABLE note_link TYPE string;
DEFINE FIELD IF NOT EXISTS target_heading ON TABLE note_link TYPE option<string>;
DEFINE FIELD IF NOT EXISTS target_block ON TABLE note_link TYPE option<string>;
DEFINE FIELD IF NOT EXISTS alias ON TABLE note_link TYPE option<string>;
DEFINE FIELD IF NOT EXISTS link_kind ON TABLE note_link TYPE string ASSERT $value IN ["wikilink", "markdown", "embed", "tag", "block-ref"];
DEFINE FIELD IF NOT EXISTS resolved ON TABLE note_link TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS source_start ON TABLE note_link TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS source_end ON TABLE note_link TYPE int ASSERT $value >= $this.source_start;
DEFINE FIELD IF NOT EXISTS created ON TABLE note_link TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE note_link TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_note_link_span ON TABLE note_link COLUMNS source_note_id, source_start, source_end UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_note_link_target ON TABLE note_link COLUMNS target_note_id, resolved;

DEFINE TABLE IF NOT EXISTS knowledge_task SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_task TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS note_id ON TABLE knowledge_task TYPE record<note>;
DEFINE FIELD IF NOT EXISTS block_id ON TABLE knowledge_task TYPE record<note_block>;
DEFINE FIELD IF NOT EXISTS status ON TABLE knowledge_task TYPE string ASSERT $value IN ["todo", "doing", "done", "canceled", "unknown"];
DEFINE FIELD IF NOT EXISTS scheduled ON TABLE knowledge_task TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS due ON TABLE knowledge_task TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS completed ON TABLE knowledge_task TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS priority ON TABLE knowledge_task TYPE option<string>;
DEFINE FIELD IF NOT EXISTS recurrence ON TABLE knowledge_task TYPE option<string>;
DEFINE FIELD IF NOT EXISTS tags ON TABLE knowledge_task TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS created ON TABLE knowledge_task TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE knowledge_task TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_task_block ON TABLE knowledge_task COLUMNS block_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_task_status ON TABLE knowledge_task COLUMNS status, due;

DEFINE TABLE IF NOT EXISTS vault_revision SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE vault_revision TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS vault_file_id ON TABLE vault_revision TYPE record<vault_file>;
DEFINE FIELD IF NOT EXISTS operation_id ON TABLE vault_revision TYPE string;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE vault_revision TYPE string;
DEFINE FIELD IF NOT EXISTS previous_hash ON TABLE vault_revision TYPE option<string>;
DEFINE FIELD IF NOT EXISTS snapshot_path ON TABLE vault_revision TYPE option<string>;
DEFINE FIELD IF NOT EXISTS size_bytes ON TABLE vault_revision TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS retention_class ON TABLE vault_revision TYPE string;
DEFINE FIELD IF NOT EXISTS created ON TABLE vault_revision TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE INDEX IF NOT EXISTS idx_vault_revision_operation ON TABLE vault_revision COLUMNS operation_id, vault_file_id UNIQUE;

DEFINE TABLE IF NOT EXISTS vault_sync_receipt SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE vault_sync_receipt TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS operation_id ON TABLE vault_sync_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS vault_id ON TABLE vault_sync_receipt TYPE record<vault_mount>;
DEFINE FIELD IF NOT EXISTS vault_file_id ON TABLE vault_sync_receipt TYPE record<vault_file>;
DEFINE FIELD IF NOT EXISTS operation ON TABLE vault_sync_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS source ON TABLE vault_sync_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS before_hash ON TABLE vault_sync_receipt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS after_hash ON TABLE vault_sync_receipt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS observed_modified_ns ON TABLE vault_sync_receipt TYPE option<int>;
DEFINE FIELD IF NOT EXISTS parser_version ON TABLE vault_sync_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS policy_decision ON TABLE vault_sync_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS status ON TABLE vault_sync_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS error_code ON TABLE vault_sync_receipt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS rollback_path ON TABLE vault_sync_receipt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS started_at ON TABLE vault_sync_receipt TYPE datetime;
DEFINE FIELD IF NOT EXISTS completed_at ON TABLE vault_sync_receipt TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS idx_vault_receipt_operation ON TABLE vault_sync_receipt COLUMNS operation_id, vault_file_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_vault_receipt_vault ON TABLE vault_sync_receipt COLUMNS vault_id, started_at;

DEFINE TABLE IF NOT EXISTS vault_trust_record SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE vault_trust_record TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS manifest_id ON TABLE vault_trust_record TYPE string;
DEFINE FIELD IF NOT EXISTS vault_id ON TABLE vault_trust_record TYPE option<record<vault_mount>>;
DEFINE FIELD IF NOT EXISTS vault_file_id ON TABLE vault_trust_record TYPE option<record<vault_file>>;
DEFINE FIELD IF NOT EXISTS note_id ON TABLE vault_trust_record TYPE option<record<note>>;
DEFINE FIELD IF NOT EXISTS canonical_relative_path ON TABLE vault_trust_record TYPE option<string>;
DEFINE FIELD IF NOT EXISTS status ON TABLE vault_trust_record TYPE string DEFAULT "approved" ASSERT $value = "approved";
DEFINE FIELD IF NOT EXISTS resolution_state ON TABLE vault_trust_record TYPE string DEFAULT "unresolved" ASSERT $value IN ["resolved", "unresolved"];
DEFINE FIELD IF NOT EXISTS reviewer ON TABLE vault_trust_record TYPE option<string>;
DEFINE FIELD IF NOT EXISTS reviewed_at ON TABLE vault_trust_record TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS source_type ON TABLE vault_trust_record TYPE string;
DEFINE FIELD IF NOT EXISTS evidence_class ON TABLE vault_trust_record TYPE string;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE vault_trust_record TYPE string;
DEFINE FIELD IF NOT EXISTS derived_from ON TABLE vault_trust_record TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS manifest_relative_path ON TABLE vault_trust_record TYPE string;
DEFINE FIELD IF NOT EXISTS created ON TABLE vault_trust_record TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE vault_trust_record TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_vault_trust_manifest ON TABLE vault_trust_record COLUMNS manifest_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_vault_trust_resolution ON TABLE vault_trust_record COLUMNS resolution_state, status;
