DEFINE TABLE IF NOT EXISTS source_visual_cache SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE source_visual_cache TYPE int DEFAULT 1 ASSERT $value = 1;
DEFINE FIELD IF NOT EXISTS source_id ON TABLE source_visual_cache TYPE record<source>;
DEFINE FIELD IF NOT EXISTS source_updated_at ON TABLE source_visual_cache TYPE datetime;
DEFINE FIELD IF NOT EXISTS source_file_sha256 ON TABLE source_visual_cache TYPE option<string> ASSERT $value = NONE OR string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS content_sha256 ON TABLE source_visual_cache TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS asset_sha256 ON TABLE source_visual_cache TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS asset_relpath ON TABLE source_visual_cache TYPE string ASSERT string::len($value) >= 1 AND string::len($value) <= 512;
DEFINE FIELD IF NOT EXISTS origin ON TABLE source_visual_cache TYPE string ASSERT $value IN ["embedded", "video_frame", "audio_artwork"];
DEFINE FIELD IF NOT EXISTS source_locator ON TABLE source_visual_cache FLEXIBLE TYPE object;
DEFINE FIELD IF NOT EXISTS extractor_version ON TABLE source_visual_cache TYPE string ASSERT string::len($value) >= 1 AND string::len($value) <= 64;
DEFINE FIELD IF NOT EXISTS alt_text ON TABLE source_visual_cache TYPE string ASSERT string::len($value) >= 1 AND string::len($value) <= 300;
DEFINE FIELD IF NOT EXISTS width ON TABLE source_visual_cache TYPE int ASSERT $value >= 1 AND $value <= 1280;
DEFINE FIELD IF NOT EXISTS height ON TABLE source_visual_cache TYPE int ASSERT $value >= 1 AND $value <= 720;
DEFINE FIELD IF NOT EXISTS mime_type ON TABLE source_visual_cache TYPE string ASSERT $value = "image/webp";
DEFINE FIELD IF NOT EXISTS created_at ON TABLE source_visual_cache TYPE datetime;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE source_visual_cache TYPE datetime;
DEFINE INDEX IF NOT EXISTS idx_source_visual_identity ON TABLE source_visual_cache COLUMNS source_id, content_sha256 UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_source_visual_updated ON TABLE source_visual_cache COLUMNS updated_at;

DEFINE TABLE IF NOT EXISTS source_visual_claim SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS claim_id ON TABLE source_visual_claim TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS source_id ON TABLE source_visual_claim TYPE record<source>;
DEFINE FIELD IF NOT EXISTS content_sha256 ON TABLE source_visual_claim TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS extractor_version ON TABLE source_visual_claim TYPE string ASSERT string::len($value) >= 1 AND string::len($value) <= 64;
DEFINE FIELD IF NOT EXISTS owner_token ON TABLE source_visual_claim TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS lease_until ON TABLE source_visual_claim TYPE datetime;
DEFINE FIELD IF NOT EXISTS command_id ON TABLE source_visual_claim TYPE option<record<command>>;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE source_visual_claim TYPE datetime;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE source_visual_claim TYPE datetime;
DEFINE INDEX IF NOT EXISTS idx_source_visual_claim_identity ON TABLE source_visual_claim COLUMNS claim_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_source_visual_claim_source ON TABLE source_visual_claim COLUMNS source_id;
DEFINE INDEX IF NOT EXISTS idx_source_visual_claim_lease ON TABLE source_visual_claim COLUMNS lease_until;

DEFINE TABLE IF NOT EXISTS source_visual_operation SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS operation_id ON TABLE source_visual_operation TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS source_id ON TABLE source_visual_operation TYPE record<source>;
DEFINE FIELD IF NOT EXISTS request_id ON TABLE source_visual_operation TYPE string ASSERT string::len($value) >= 1 AND string::len($value) <= 256;
DEFINE FIELD IF NOT EXISTS source_updated_at ON TABLE source_visual_operation TYPE datetime;
DEFINE FIELD IF NOT EXISTS content_sha256 ON TABLE source_visual_operation TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS operation ON TABLE source_visual_operation TYPE string ASSERT $value IN ["refresh", "delete"];
DEFINE FIELD IF NOT EXISTS command_id ON TABLE source_visual_operation TYPE option<record<command>>;
DEFINE FIELD IF NOT EXISTS outcome ON TABLE source_visual_operation TYPE string ASSERT $value IN ["queued", "replayed", "deleted", "failed"];
DEFINE FIELD IF NOT EXISTS error_code ON TABLE source_visual_operation TYPE option<string> ASSERT $value = NONE OR (string::len($value) >= 1 AND string::len($value) <= 64 AND string::matches($value, "^[a-z0-9][a-z0-9_.-]*$"));
DEFINE FIELD IF NOT EXISTS created_at ON TABLE source_visual_operation TYPE datetime;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE source_visual_operation TYPE datetime;
DEFINE INDEX IF NOT EXISTS idx_source_visual_operation_identity ON TABLE source_visual_operation COLUMNS operation_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_source_visual_operation_request ON TABLE source_visual_operation COLUMNS source_id, request_id, operation UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_source_visual_operation_updated ON TABLE source_visual_operation COLUMNS updated_at;
