-- Unified knowledge engine shadow schema with no legacy projection mutation.

DEFINE TABLE IF NOT EXISTS knowledge_engine_space SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_space TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS display_name ON TABLE knowledge_engine_space TYPE string;
DEFINE FIELD IF NOT EXISTS authority_kind ON TABLE knowledge_engine_space TYPE string ASSERT $value IN ["app_owned", "external_read_only"];
DEFINE FIELD IF NOT EXISTS source_kind ON TABLE knowledge_engine_space TYPE string ASSERT $value IN ["overlay", "obsidian", "logseq", "markdown"];
DEFINE FIELD IF NOT EXISTS source_ref ON TABLE knowledge_engine_space TYPE string;
DEFINE FIELD IF NOT EXISTS format_mode ON TABLE knowledge_engine_space TYPE string ASSERT $value IN ["obsidian", "logseq", "mixed", "markdown"];
DEFINE FIELD IF NOT EXISTS availability_state ON TABLE knowledge_engine_space TYPE string ASSERT $value IN ["available", "unavailable", "stale", "degraded"];
DEFINE FIELD IF NOT EXISTS projection_state ON TABLE knowledge_engine_space TYPE string ASSERT $value IN ["pending", "projecting", "ready", "failed"];
DEFINE FIELD IF NOT EXISTS adapter_version ON TABLE knowledge_engine_space TYPE string;
DEFINE FIELD IF NOT EXISTS parser_version ON TABLE knowledge_engine_space TYPE string;
DEFINE FIELD IF NOT EXISTS policy_version ON TABLE knowledge_engine_space TYPE int ASSERT $value >= 1;
DEFINE FIELD IF NOT EXISTS `capabilities` ON TABLE knowledge_engine_space TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS created_at ON TABLE knowledge_engine_space TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE knowledge_engine_space TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_ke_space_source ON TABLE knowledge_engine_space COLUMNS source_kind, source_ref UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_document SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_document TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS source_native_id ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS authority_kind ON TABLE knowledge_engine_document TYPE string ASSERT $value IN ["app_owned", "external_read_only"];
DEFINE FIELD IF NOT EXISTS relative_locator ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS document_kind ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS title ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS normalized_body ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS properties ON TABLE knowledge_engine_document FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS tags ON TABLE knowledge_engine_document TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS provenance ON TABLE knowledge_engine_document TYPE string;
DEFINE FIELD IF NOT EXISTS availability ON TABLE knowledge_engine_document TYPE string ASSERT $value IN ["available", "referenced", "missing", "unavailable"];
DEFINE FIELD IF NOT EXISTS parse_state ON TABLE knowledge_engine_document TYPE string ASSERT $value IN ["pending", "ready", "invalid", "unsupported", "conflict", "missing", "failed"];
DEFINE FIELD IF NOT EXISTS journal_date ON TABLE knowledge_engine_document TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS `capabilities` ON TABLE knowledge_engine_document TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS created_at ON TABLE knowledge_engine_document TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS observed_at ON TABLE knowledge_engine_document TYPE datetime;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE knowledge_engine_document TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_ke_document_locator ON TABLE knowledge_engine_document COLUMNS space_id, relative_locator UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_ke_document_native ON TABLE knowledge_engine_document COLUMNS space_id, source_native_id;

DEFINE TABLE IF NOT EXISTS knowledge_engine_block SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_block TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS document_id ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS parent_block_id ON TABLE knowledge_engine_block TYPE option<string>;
DEFINE FIELD IF NOT EXISTS position ON TABLE knowledge_engine_block TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS source_key ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS block_kind ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS markdown ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS plain_text ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS properties ON TABLE knowledge_engine_block FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS raw_task_state ON TABLE knowledge_engine_block TYPE option<string>;
DEFINE FIELD IF NOT EXISTS normalized_task_state ON TABLE knowledge_engine_block TYPE option<string> ASSERT $value = NONE OR $value IN ["open", "in_progress", "done", "cancelled", "unknown"];
DEFINE FIELD IF NOT EXISTS heading_path ON TABLE knowledge_engine_block TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS source_start ON TABLE knowledge_engine_block TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS source_end ON TABLE knowledge_engine_block TYPE int ASSERT $value >= $this.source_start;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_block TYPE string;
DEFINE FIELD IF NOT EXISTS `capabilities` ON TABLE knowledge_engine_block TYPE array<string> DEFAULT [];
DEFINE INDEX IF NOT EXISTS idx_ke_block_source ON TABLE knowledge_engine_block COLUMNS document_id, source_key UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_relation SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_relation TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_relation TYPE string;
DEFINE FIELD IF NOT EXISTS source_document_id ON TABLE knowledge_engine_relation TYPE string;
DEFINE FIELD IF NOT EXISTS source_block_id ON TABLE knowledge_engine_relation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS target_document_id ON TABLE knowledge_engine_relation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS target_block_id ON TABLE knowledge_engine_relation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS target_text ON TABLE knowledge_engine_relation TYPE string;
DEFINE FIELD IF NOT EXISTS target_heading ON TABLE knowledge_engine_relation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS target_block ON TABLE knowledge_engine_relation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS alias ON TABLE knowledge_engine_relation TYPE option<string>;
DEFINE FIELD IF NOT EXISTS relation_kind ON TABLE knowledge_engine_relation TYPE string;
DEFINE FIELD IF NOT EXISTS resolved ON TABLE knowledge_engine_relation TYPE bool;
DEFINE FIELD IF NOT EXISTS source_start ON TABLE knowledge_engine_relation TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS source_end ON TABLE knowledge_engine_relation TYPE int ASSERT $value >= $this.source_start;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_relation TYPE string;
DEFINE INDEX IF NOT EXISTS idx_ke_relation_source_span ON TABLE knowledge_engine_relation COLUMNS source_document_id, source_start, source_end, relation_kind UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_task SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_task TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_task TYPE string;
DEFINE FIELD IF NOT EXISTS document_id ON TABLE knowledge_engine_task TYPE string;
DEFINE FIELD IF NOT EXISTS block_id ON TABLE knowledge_engine_task TYPE option<string>;
DEFINE FIELD IF NOT EXISTS raw_status ON TABLE knowledge_engine_task TYPE string;
DEFINE FIELD IF NOT EXISTS normalized_status ON TABLE knowledge_engine_task TYPE string ASSERT $value IN ["open", "in_progress", "done", "cancelled", "unknown"];
DEFINE FIELD IF NOT EXISTS scheduled ON TABLE knowledge_engine_task TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS due ON TABLE knowledge_engine_task TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS completed ON TABLE knowledge_engine_task TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS priority ON TABLE knowledge_engine_task TYPE option<string>;
DEFINE FIELD IF NOT EXISTS recurrence ON TABLE knowledge_engine_task TYPE option<string>;
DEFINE FIELD IF NOT EXISTS tags ON TABLE knowledge_engine_task TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS properties ON TABLE knowledge_engine_task FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS source_start ON TABLE knowledge_engine_task TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS source_end ON TABLE knowledge_engine_task TYPE int ASSERT $value >= $this.source_start;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_task TYPE string;
DEFINE FIELD IF NOT EXISTS `capabilities` ON TABLE knowledge_engine_task TYPE array<string> DEFAULT [];
DEFINE INDEX IF NOT EXISTS idx_ke_task_block ON TABLE knowledge_engine_task COLUMNS document_id, block_id UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_asset SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_asset TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_asset TYPE string;
DEFINE FIELD IF NOT EXISTS source_document_id ON TABLE knowledge_engine_asset TYPE string;
DEFINE FIELD IF NOT EXISTS relative_locator ON TABLE knowledge_engine_asset TYPE string;
DEFINE FIELD IF NOT EXISTS media_kind ON TABLE knowledge_engine_asset TYPE string;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE knowledge_engine_asset TYPE option<string>;
DEFINE FIELD IF NOT EXISTS byte_size ON TABLE knowledge_engine_asset TYPE option<int> ASSERT $value = NONE OR $value >= 0;
DEFINE FIELD IF NOT EXISTS availability ON TABLE knowledge_engine_asset TYPE string ASSERT $value IN ["available", "referenced", "missing", "unavailable"];
DEFINE FIELD IF NOT EXISTS metadata ON TABLE knowledge_engine_asset FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS provenance ON TABLE knowledge_engine_asset TYPE string;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_asset TYPE string;
DEFINE FIELD IF NOT EXISTS `capabilities` ON TABLE knowledge_engine_asset TYPE array<string> DEFAULT [];

DEFINE TABLE IF NOT EXISTS knowledge_engine_view SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_view TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_view TYPE string;
DEFINE FIELD IF NOT EXISTS view_kind ON TABLE knowledge_engine_view TYPE string ASSERT $value IN ["document", "collection", "graph"];
DEFINE FIELD IF NOT EXISTS name ON TABLE knowledge_engine_view TYPE string;
DEFINE FIELD IF NOT EXISTS revision ON TABLE knowledge_engine_view TYPE int ASSERT $value >= 1;
DEFINE FIELD IF NOT EXISTS target_ids ON TABLE knowledge_engine_view TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS definition ON TABLE knowledge_engine_view FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS view_state ON TABLE knowledge_engine_view FLEXIBLE TYPE object;
DEFINE FIELD IF NOT EXISTS `capabilities` ON TABLE knowledge_engine_view TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS created_at ON TABLE knowledge_engine_view TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE knowledge_engine_view TYPE datetime DEFAULT time::now() VALUE time::now();

DEFINE TABLE IF NOT EXISTS knowledge_engine_source_revision SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_source_revision TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_source_revision TYPE string;
DEFINE FIELD IF NOT EXISTS document_id ON TABLE knowledge_engine_source_revision TYPE string;
DEFINE FIELD IF NOT EXISTS content_hash ON TABLE knowledge_engine_source_revision TYPE string;
DEFINE FIELD IF NOT EXISTS byte_size ON TABLE knowledge_engine_source_revision TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS encoding ON TABLE knowledge_engine_source_revision TYPE option<string>;
DEFINE FIELD IF NOT EXISTS newline ON TABLE knowledge_engine_source_revision TYPE option<string> ASSERT $value = NONE OR $value IN ["lf", "crlf", "mixed", "none"];
DEFINE FIELD IF NOT EXISTS observed_modified_ns ON TABLE knowledge_engine_source_revision TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS adapter_version ON TABLE knowledge_engine_source_revision TYPE string;
DEFINE FIELD IF NOT EXISTS parser_version ON TABLE knowledge_engine_source_revision TYPE string;
DEFINE FIELD IF NOT EXISTS parse_status ON TABLE knowledge_engine_source_revision TYPE string ASSERT $value IN ["pending", "ready", "invalid", "unsupported", "conflict", "missing", "failed"];
DEFINE FIELD IF NOT EXISTS diagnostics ON TABLE knowledge_engine_source_revision FLEXIBLE TYPE array<object> DEFAULT [];
DEFINE FIELD IF NOT EXISTS observed_at ON TABLE knowledge_engine_source_revision TYPE datetime;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE knowledge_engine_source_revision TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE INDEX IF NOT EXISTS idx_ke_revision_hash ON TABLE knowledge_engine_source_revision COLUMNS document_id, content_hash UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_identity_map SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_identity_map TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS legacy_kind ON TABLE knowledge_engine_identity_map TYPE string;
DEFINE FIELD IF NOT EXISTS legacy_id ON TABLE knowledge_engine_identity_map TYPE string;
DEFINE FIELD IF NOT EXISTS engine_kind ON TABLE knowledge_engine_identity_map TYPE string;
DEFINE FIELD IF NOT EXISTS engine_id ON TABLE knowledge_engine_identity_map TYPE string;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_identity_map TYPE string;
DEFINE FIELD IF NOT EXISTS claim_hash ON TABLE knowledge_engine_identity_map TYPE string;
DEFINE FIELD IF NOT EXISTS created_at ON TABLE knowledge_engine_identity_map TYPE datetime DEFAULT time::now() VALUE $before OR time::now();
DEFINE INDEX IF NOT EXISTS idx_ke_identity_legacy ON TABLE knowledge_engine_identity_map COLUMNS legacy_kind, legacy_id, source_revision_id UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_projection_receipt SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_projection_receipt TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS operation_id ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS document_id ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS source_revision_id ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS relative_locator ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS input_hash ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS output_hash ON TABLE knowledge_engine_projection_receipt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS adapter_version ON TABLE knowledge_engine_projection_receipt TYPE string;
DEFINE FIELD IF NOT EXISTS status ON TABLE knowledge_engine_projection_receipt TYPE string ASSERT $value IN ["projected", "unchanged", "failed"];
DEFINE FIELD IF NOT EXISTS error_code ON TABLE knowledge_engine_projection_receipt TYPE option<string>;
DEFINE FIELD IF NOT EXISTS started_at ON TABLE knowledge_engine_projection_receipt TYPE datetime;
DEFINE FIELD IF NOT EXISTS completed_at ON TABLE knowledge_engine_projection_receipt TYPE option<datetime>;
DEFINE INDEX IF NOT EXISTS idx_ke_receipt_operation ON TABLE knowledge_engine_projection_receipt COLUMNS operation_id UNIQUE;

DEFINE TABLE IF NOT EXISTS knowledge_engine_backfill_checkpoint SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE knowledge_engine_backfill_checkpoint TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS space_id ON TABLE knowledge_engine_backfill_checkpoint TYPE string;
DEFINE FIELD IF NOT EXISTS last_relative_locator ON TABLE knowledge_engine_backfill_checkpoint TYPE option<string>;
DEFINE FIELD IF NOT EXISTS last_source_hash ON TABLE knowledge_engine_backfill_checkpoint TYPE option<string>;
DEFINE FIELD IF NOT EXISTS status ON TABLE knowledge_engine_backfill_checkpoint TYPE string ASSERT $value IN ["pending", "running", "completed", "failed"];
DEFINE FIELD IF NOT EXISTS projected ON TABLE knowledge_engine_backfill_checkpoint TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS unchanged ON TABLE knowledge_engine_backfill_checkpoint TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS failed ON TABLE knowledge_engine_backfill_checkpoint TYPE int ASSERT $value >= 0;
DEFINE FIELD IF NOT EXISTS updated_at ON TABLE knowledge_engine_backfill_checkpoint TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX IF NOT EXISTS idx_ke_checkpoint_space ON TABLE knowledge_engine_backfill_checkpoint COLUMNS space_id UNIQUE;
