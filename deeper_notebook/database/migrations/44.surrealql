-- Bounded Anki import compatibility receipts. Native cards and scheduling
-- remain owned by study_card/study_review and study_plan_card.
DEFINE TABLE IF NOT EXISTS study_anki_import SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS schema_version ON TABLE study_anki_import TYPE int DEFAULT 1 ASSERT $value = 1;
DEFINE FIELD IF NOT EXISTS receipt_id ON TABLE study_anki_import TYPE string ASSERT string::trim($value) != "" AND string::len($value) <= 512;
DEFINE FIELD IF NOT EXISTS plan_id ON TABLE study_anki_import TYPE string ASSERT string::trim($value) != "" AND string::len($value) <= 512;
DEFINE FIELD IF NOT EXISTS request_id ON TABLE study_anki_import TYPE string ASSERT string::trim($value) != "" AND string::len($value) <= 256;
DEFINE FIELD IF NOT EXISTS payload_sha256 ON TABLE study_anki_import TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS package_sha256 ON TABLE study_anki_import TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS collection_sha256 ON TABLE study_anki_import TYPE string ASSERT string::matches($value, "^[0-9a-f]{64}$");
DEFINE FIELD IF NOT EXISTS collection_member ON TABLE study_anki_import TYPE string ASSERT $value IN ["collection.anki2", "collection.anki21"];
DEFINE FIELD IF NOT EXISTS card_count ON TABLE study_anki_import TYPE int ASSERT $value >= 0 AND $value <= 10000;
DEFINE FIELD IF NOT EXISTS transformed_count ON TABLE study_anki_import TYPE int ASSERT $value >= 0 AND $value <= 10000;
DEFINE FIELD IF NOT EXISTS skipped_count ON TABLE study_anki_import TYPE int ASSERT $value >= 0 AND $value <= 10000;
DEFINE FIELD IF NOT EXISTS card_ids ON TABLE study_anki_import TYPE array<string> ASSERT array::len($value) <= 10000 AND array::every($value, |$item| string::trim($item) != "" AND string::len($item) <= 512);
DEFINE FIELD IF NOT EXISTS deck_names ON TABLE study_anki_import TYPE array<string> ASSERT array::len($value) <= 1000 AND array::every($value, |$item| string::trim($item) != "" AND string::len($item) <= 200);
DEFINE FIELD IF NOT EXISTS tags ON TABLE study_anki_import TYPE array<string> ASSERT array::len($value) <= 1000 AND array::every($value, |$item| string::trim($item) != "" AND string::len($item) <= 128);
DEFINE FIELD IF NOT EXISTS media_names ON TABLE study_anki_import TYPE array<string> ASSERT array::len($value) <= 500 AND array::every($value, |$item| string::trim($item) != "" AND string::len($item) <= 512);
DEFINE FIELD IF NOT EXISTS syllabus_unit_id ON TABLE study_anki_import TYPE option<string> ASSERT $value = NONE OR string::matches($value, "^[a-z0-9][a-z0-9_-]{0,63}$");
DEFINE FIELD IF NOT EXISTS created_at ON TABLE study_anki_import TYPE datetime;
DEFINE INDEX IF NOT EXISTS idx_study_anki_import_request ON TABLE study_anki_import COLUMNS plan_id, request_id UNIQUE;
DEFINE INDEX IF NOT EXISTS idx_study_anki_import_payload ON TABLE study_anki_import COLUMNS plan_id, payload_sha256 UNIQUE;
