-- v0.8.73 -- Durable, resumable research runs.
DEFINE TABLE IF NOT EXISTS research_run SCHEMAFULL;

DEFINE FIELD IF NOT EXISTS schema_version ON TABLE research_run TYPE int DEFAULT 1;
DEFINE FIELD IF NOT EXISTS notebook_id ON TABLE research_run TYPE option<record<notebook>>;
DEFINE FIELD IF NOT EXISTS objective ON TABLE research_run TYPE string;
DEFINE FIELD IF NOT EXISTS stage ON TABLE research_run TYPE string DEFAULT "plan";
DEFINE FIELD IF NOT EXISTS plan ON TABLE research_run FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS hypotheses ON TABLE research_run TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS search_queries ON TABLE research_run TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS candidates ON TABLE research_run FLEXIBLE TYPE array<object> DEFAULT [];
DEFINE FIELD IF NOT EXISTS approval_decisions ON TABLE research_run FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS source_ids ON TABLE research_run TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS checkpoints ON TABLE research_run FLEXIBLE TYPE object DEFAULT {};
DEFINE FIELD IF NOT EXISTS completed_stages ON TABLE research_run TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS errors ON TABLE research_run TYPE array<string> DEFAULT [];
DEFINE FIELD IF NOT EXISTS cancelled ON TABLE research_run TYPE bool DEFAULT false;
DEFINE FIELD IF NOT EXISTS command_id ON TABLE research_run TYPE option<string>;
DEFINE FIELD IF NOT EXISTS created ON TABLE research_run DEFAULT time::now() VALUE $before OR time::now();
DEFINE FIELD IF NOT EXISTS updated ON TABLE research_run DEFAULT time::now() VALUE time::now();

DEFINE INDEX IF NOT EXISTS idx_research_run_notebook ON TABLE research_run COLUMNS notebook_id;
DEFINE INDEX IF NOT EXISTS idx_research_run_stage ON TABLE research_run COLUMNS stage;
DEFINE INDEX IF NOT EXISTS idx_research_run_updated ON TABLE research_run COLUMNS updated;
