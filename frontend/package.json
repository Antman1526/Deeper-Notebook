{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "node start-server.js",
    "lint": "eslint src/",
    "test": "vitest run --pool=forks --maxWorkers=1",
    "test:feature-build-contract": "NEXT_PUBLIC_DN_EVIDENCE_STUDIO=enabled NEXT_PUBLIC_ONP_EVIDENCE_STUDIO=0 NEXT_PUBLIC_DN_VISUAL_REFRESH=0 NEXT_PUBLIC_ONP_VISUAL_REFRESH=enabled NEXT_PUBLIC_DN_MODEL_FLEET=yes NEXT_PUBLIC_ONP_MODEL_FLEET=no NEXT_PUBLIC_DN_RESEARCH_RUNS=false NEXT_PUBLIC_ONP_RESEARCH_RUNS=true next build tests/build-contract && node scripts/verify-feature-env-build.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e:mocked": "playwright test --project=mocked-browser",
    "test:e2e:native": "playwright test --project=native-runtime",
    "test:e2e:device": "playwright test --project=packaged-device"
  },
