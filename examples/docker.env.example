# v0.8.66 (audit I-4) — example env file for the docker-compose examples that
# declare `env_file: ./docker.env` (docker-compose-single.yml,
# docker-compose-dev.yml). Copy this to `docker.env` next to the compose file
# and edit the values:
#
#     cp docker.env.example docker.env
#
# Without this the copy-paste examples failed immediately ("env file
# ./docker.env not found"). NOTE: the desktop app does NOT use Docker — these
# examples are for self-hosted/server deployments only.

# --- Security (CHANGE THESE) -------------------------------------------------
# Field-level encryption key for stored API keys. Any non-empty string; it is
# derived to a Fernet key via SHA-256. REQUIRED to store credentials.
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# Shared password for the API/UI (PasswordAuthMiddleware). Leave UNSET for a
# trusted local-only deployment; set a strong value for any exposed deployment.
# OPEN_NOTEBOOK_PASSWORD=change-me-to-a-strong-password

# --- SurrealDB ---------------------------------------------------------------
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# --- Optional: local model providers ----------------------------------------
# OLLAMA_BASE_URL=http://ollama:11434

# --- Optional: AI provider API keys (or configure them in the UI) -----------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
