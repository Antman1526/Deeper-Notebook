# Open Notebook Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Change this to any secret string (minimum 16 characters recommended)
OPEN_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# You can configure these via the UI (Settings → API Keys) or set them here
# UI configuration is recommended for better security and flexibility

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint (if running locally)
# OLLAMA_BASE_URL=http://ollama:11434

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Security
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=secret

# =============================================================================
# OPEN NOTEBOOK PLUS — Local-deploy knobs (ONP_*)
# =============================================================================
# These ONP_* env vars are specific to the desktop / local-first build.
# All have sane defaults — only set them if you need to tune for your
# hardware. Full reference: docs/5-CONFIGURATION/environment-reference.md
#
# --- Encryption key rotation (v0.7.17) ---
# Use the singular OPEN_NOTEBOOK_ENCRYPTION_KEY (above) for normal
# operation. To rotate without re-entering every credential, set the
# plural KEYS env var with comma-separated values: first = new
# primary key, rest = old keys accepted for decryption. After running
# a re-encrypt sweep, drop the old keys.
# OPEN_NOTEBOOK_ENCRYPTION_KEYS=new-secret,old-secret
#
# --- Logging (v0.7.14) ---
# ONP_LOG_DIR=                  # default ~/.open-notebook-plus/logs
# ONP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# ONP_LOG_JSON=0                # set to 1 for a parallel .jsonl sink
#
# --- Health probes (v0.7.15) ---
# Endpoints /livez and /readyz are always-on; no config needed.
#
# --- Source upload byte cap (v0.7.16) ---
# ONP_SOURCE_UPLOAD_MAX_BYTES=524288000   # default 500 MB
#
# --- SurrealDB connection pool (v0.7.18) ---
# ONP_DB_POOL_SIZE=4            # default 4; range 1-32
# ONP_DB_POOL_DISABLED=         # set to 1 to disable pool (debug only)
#
# --- Studio one-shot generation caps (v0.7.4) ---
# ONP_STUDIO_MAX_FILE_CHARS=15000           # per-file char ceiling
# ONP_STUDIO_MAX_COMBINED_CHARS=60000       # combined-input ceiling
#
# --- Chat LLM server context window (v0.7.8) ---
# ONP_CHAT_LLM_CTX=16384        # llama-cpp-python --n_ctx; default 16k
#
# --- Memory writer LLM (v0.7.5) ---
# ONP_CHAT_TIMEOUT_S=30         # per-turn extraction timeout
# ONP_CHAT_MODEL_NAME=default   # model name passed to local OpenAI-compat server
# ONP_CHAT_RAM_GB_CEILING=      # capability-aware spawner RAM ceiling
#
# --- Ask graph result caps (v0.7.9) ---
# ONP_ASK_MAX_RESULTS=10                    # max vector_search rows
# ONP_ASK_PER_RESULT_CHAR_CAP=1500          # per-result content cap
#
# --- Transformation input cap (v0.7.10) ---
# ONP_TRANSFORMATION_INPUT_CAP=12000        # source.full_text cap
#
# --- Chat history caps (v0.7.11 + v0.7.13) ---
# ONP_CHAT_HISTORY_CHAR_CAP=12000           # message history budget
# ONP_SOURCE_CHAT_HISTORY_CHAR_CAP=8000     # source-chat history budget
#
# --- source_chat context caps (v0.7.12) ---
# ONP_SOURCE_CHAT_SOURCE_CHAR_CAP=4000      # source full_text cap
# ONP_SOURCE_CHAT_INSIGHT_CHAR_CAP=1000     # per-insight content cap
# ONP_SOURCE_CHAT_MAX_INSIGHTS=10           # max insights injected
#
# --- Native web search for chat (v0.8.64 / v0.8.65) -----------------------
# Drop in ONE provider key/URL below and the chat model gains a built-in
# `web_search` tool (no MCP server needed). Opt-in: with none of these set the
# tool is never bound and chat behaviour is unchanged. v0.8.65 — these now form
# a FAILOVER CHAIN: precedence Serper > Tavily > SearXNG, and an attempt that
# errors falls through to the next (the happy path still stops at the first, so
# no extra API spend). Override the order with ONP_WEB_SEARCH_PROVIDER.
# SERPER_API_KEY=                 # Serper (Google Search API) — https://serper.dev
# TAVILY_API_KEY=                 # Tavily search API          — https://tavily.com
# SEARXNG_BASE_URL=               # SearXNG instance(s). v0.8.65 — comma-separate
#                                 # several for per-instance failover, e.g.
#                                 # http://127.0.0.1:8080,https://searx.example/
#                                 # NOTE: most PUBLIC SearXNG mirrors block the
#                                 # JSON API (429/403) — run your own local
#                                 # instance for reliable keyless search.
# ONP_WEB_SEARCH_PROVIDER=        # force one of: serper | tavily | searxng (default: auto)
# ONP_WEB_SEARCH_MAX_RESULTS=5    # results per query (1-20)
# ONP_WEB_SEARCH_TIMEOUT_SEC=10   # per-request HTTP timeout (1-60)
#
# --- Internal shim wiring (set by the launcher; not user-facing) ---
# ONP_MEMORY_URL          ONP_MEMORY_INJECTED
# ONP_STT_URL             ONP_TTS_URL
# ONP_VOICE_INJECTED      ONP_REMIND_OPENCHRONICLE

# For upstream/Docker config options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md
