# Deeper Notebook Configuration
# Copy this file to .env and customize as needed
#
# Canonical product settings use DEEPER_NOTEBOOK_*. Compatibility aliases
# remain accepted with this precedence:
# DEEPER_NOTEBOOK_* > DN_* > DEEPER_NOTEBOOK_* > DEEPER_NOTEBOOK_* > built-in default.
# DEEPER_NOTEBOOK_* and DEEPER_NOTEBOOK_* are deprecated; deliberately empty values count as
# assigned. Prefer the canonical long names shown in this file.

# =============================================================================
# REQUIRED
# =============================================================================

# Encryption key for storing API credentials securely in the database
# Change this to any secret string (minimum 16 characters recommended)
DEEPER_NOTEBOOK_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# DATABASE (Default values work with docker-compose.yml)
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
# root:root is fine for local use. Change these before exposing the instance to a
# network — docker-compose.yml reads them for both the SurrealDB server and the
# app, so the two stay in sync.
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=open_notebook
SURREAL_DATABASE=open_notebook

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# You can configure these via the UI (Settings → API Keys) or set them here
# UI configuration is recommended for better security and flexibility

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google AI
# GOOGLE_API_KEY=...

# Groq
# GROQ_API_KEY=gsk_...

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# External API URL (for webhooks, callbacks, etc.)
# API_URL=http://localhost:5055

# Ollama endpoint (if running locally)
# OLLAMA_BASE_URL=http://ollama:11434

# Content processing
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=150

# Security
# BASIC_AUTH_USERNAME=admin
# BASIC_AUTH_PASSWORD=secret

# =============================================================================
# DEEPER NOTEBOOK — Local-deploy knobs (DEEPER_NOTEBOOK_*)
# =============================================================================
# These DEEPER_NOTEBOOK_* env vars are specific to the desktop / local-first build.
# All have sane defaults — only set them if you need to tune for your
# hardware. Full reference: docs/5-CONFIGURATION/environment-reference.md
#
# --- Encryption key rotation (v0.7.17) ---
# Use the singular DEEPER_NOTEBOOK_ENCRYPTION_KEY (above) for normal
# operation. To rotate without re-entering every credential, set the
# plural KEYS env var with comma-separated values: first = new
# primary key, rest = old keys accepted for decryption. After running
# a re-encrypt sweep, drop the old keys.
# DEEPER_NOTEBOOK_ENCRYPTION_KEYS=new-secret,old-secret
#
# --- Logging (v0.7.14) ---
# DEEPER_NOTEBOOK_LOG_DIR=                  # default ~/.deeper-notebook/logs
# DEEPER_NOTEBOOK_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
# DEEPER_NOTEBOOK_LOG_JSON=0                # set to 1 for a parallel .jsonl sink
#
# --- Health probes (v0.7.15) ---
# Endpoints /livez and /readyz are always-on; no config needed.
#
# --- Source upload byte cap (v0.7.16) ---
# DEEPER_NOTEBOOK_SOURCE_UPLOAD_MAX_BYTES=524288000   # default 500 MB
#
# --- SurrealDB connection pool (v0.7.18) ---
# DEEPER_NOTEBOOK_DB_POOL_SIZE=4            # default 4; range 1-32
# DEEPER_NOTEBOOK_DB_POOL_DISABLED=         # set to 1 to disable pool (debug only)
#
# --- Studio one-shot generation caps (v0.7.4) ---
# DEEPER_NOTEBOOK_STUDIO_MAX_FILE_CHARS=15000           # per-file char ceiling
# DEEPER_NOTEBOOK_STUDIO_MAX_COMBINED_CHARS=60000       # combined-input ceiling
#
# --- Chat LLM server context window (v0.7.8) ---
# DEEPER_NOTEBOOK_CHAT_LLM_CTX=16384        # llama-cpp-python --n_ctx; default 16k
#
# --- Memory writer LLM (v0.7.5) ---
# DEEPER_NOTEBOOK_CHAT_TIMEOUT_S=30         # per-turn extraction timeout
# DEEPER_NOTEBOOK_CHAT_MODEL_NAME=default   # model name passed to local OpenAI-compat server
# DEEPER_NOTEBOOK_CHAT_RAM_GB_CEILING=      # capability-aware spawner RAM ceiling
#
# --- Ask graph result caps (v0.7.9) ---
# DEEPER_NOTEBOOK_ASK_MAX_RESULTS=10                    # max vector_search rows
# DEEPER_NOTEBOOK_ASK_PER_RESULT_CHAR_CAP=1500          # per-result content cap
#
# --- Transformation input cap (v0.7.10) ---
# DEEPER_NOTEBOOK_TRANSFORMATION_INPUT_CAP=12000        # source.full_text cap
#
# --- Chat history caps (v0.7.11 + v0.7.13) ---
# DEEPER_NOTEBOOK_CHAT_HISTORY_CHAR_CAP=12000           # message history budget
# DEEPER_NOTEBOOK_SOURCE_CHAT_HISTORY_CHAR_CAP=8000     # source-chat history budget
#
# --- source_chat context caps (v0.7.12) ---
# DEEPER_NOTEBOOK_SOURCE_CHAT_SOURCE_CHAR_CAP=4000      # source full_text cap
# DEEPER_NOTEBOOK_SOURCE_CHAT_INSIGHT_CHAR_CAP=1000     # per-insight content cap
# DEEPER_NOTEBOOK_SOURCE_CHAT_MAX_INSIGHTS=10           # max insights injected
#
# --- Native web search for chat (v0.8.64 / v0.8.65 / v0.8.82) -------------
# v0.8.82: the `web_search` tool is now bound BY DEFAULT, backed by a keyless
# Wikipedia provider — so a local model has some web reach with nothing set.
#
# Wikipedia is encyclopedic, NOT a general web index: it will not answer well
# about prices, live events, or anything newer than an article. For real general
# web search add ONE key below — each has a free tier:
#
#   Serper  2,500 free credits, no card   https://serper.dev
#   Tavily  1,000 free searches / month   https://tavily.com
#   Brave   2,000 free queries / month    https://brave.com/search/api  (see note)
#
# (DuckDuckGo is deliberately NOT offered: both its HTML endpoint and its
# Instant Answer API return HTTP 202 anti-bot challenges to scripted clients,
# so it would look configured while silently returning nothing.)
#
# These form a FAILOVER CHAIN: precedence Serper > Tavily > SearXNG > Wikipedia.
# An attempt that errors falls through to the next; the happy path still stops
# at the first, so no extra API spend. Override with
# DEEPER_NOTEBOOK_WEB_SEARCH_PROVIDER.
# SERPER_API_KEY=                 # Serper (Google Search API) — https://serper.dev
# TAVILY_API_KEY=                 # Tavily search API          — https://tavily.com
# SEARXNG_BASE_URL=               # SearXNG instance(s). v0.8.65 — comma-separate
#                                 # several for per-instance failover, e.g.
#                                 # http://127.0.0.1:8080,https://searx.example/
#                                 # NOTE: most PUBLIC SearXNG mirrors block the
#                                 # JSON API (429/403) — run your own local
#                                 # instance for reliable keyless search.
# DEEPER_NOTEBOOK_WEB_SEARCH_PROVIDER=        # force one of: serper | tavily | searxng | wikipedia (default: auto)
# DEEPER_NOTEBOOK_WEB_SEARCH_MAX_RESULTS=5    # results per query (1-20)
# DEEPER_NOTEBOOK_WEB_SEARCH_TIMEOUT_SEC=10   # per-request HTTP timeout (1-60)
# DEEPER_NOTEBOOK_WEB_SEARCH_TOTAL_BUDGET_SEC=25  # total wall-clock across the whole failover
#                                 # chain (1-120; kept < the 30s chat tool timeout)
# DEEPER_NOTEBOOK_WEB_SEARCH_KEYLESS=1        # 0 = restore the pre-v0.8.82 key-only contract
#                                 # (with no key set, the tool disappears entirely)
# DEEPER_NOTEBOOK_WEB_SEARCH_CACHE_TTL_SEC=300 # repeat-query cache (0-3600; 0 disables).
#                                 # Identical recent queries return instantly instead of
#                                 # re-hitting the provider; empty results are never cached.
#
# --- Scholarly search for chat (v0.8.82) ----------------------------------
# A second, separate chat tool: `scholarly_search`, backed by OpenAlex (~250M
# works) then arXiv. Both are KEYLESS — no account, no card — so this is on by
# default and needs nothing configured. It is deliberately distinct from
# `web_search` so the model picks literature search for research questions and
# web search for news/prices.
# DEEPER_NOTEBOOK_SCHOLARLY_SEARCH=1   # 0 disables the tool entirely
# DEEPER_NOTEBOOK_SCHOLARLY_MAILTO=    # your email → OpenAlex's faster "polite
#                                 # pool". Optional; unset just uses the common pool.
#
# --- Internal shim wiring (set by the launcher; not user-facing) ---
# DEEPER_NOTEBOOK_MEMORY_URL          DEEPER_NOTEBOOK_MEMORY_INJECTED
# DEEPER_NOTEBOOK_STT_URL             DEEPER_NOTEBOOK_TTS_URL
# DEEPER_NOTEBOOK_VOICE_INJECTED      DEEPER_NOTEBOOK_REMIND_OPENCHRONICLE

# For upstream/Docker config options, see:
# https://github.com/lfnovo/open-notebook/blob/main/docs/5-CONFIGURATION/environment-reference.md
